# Local Ollama (default config/models.yaml)
OLLAMA_BASE_URL=http://localhost:11434

# Only needed for config/models.cloud.yaml (Groq + Gemini free tiers)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional
# MODELS_CONFIG=config/models.cloud.yaml
# MODELS_CONFIG=config/models.cluster.yaml   # needs NEMOTRON_MODEL, DEEPSEEK_MODEL, CRITIC_MODEL set to your Ollama tags
# PIPELINE_LOG_PATH=logs/pipeline.jsonl     # per-node latency events (JSON lines)
# CTGOV_CACHE_MODE=off                      # off | readwrite | readonly (reproducible evals)
# CTGOV_CACHE_DIR=./ctgov_cache
# EVAL_DELAY_SECONDS=0
